{
  "buildCommand": "node scripts/build-website.mjs",
  "outputDirectory": ".website-output",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/email-verified",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/minor-purchase",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/minor-promotion",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/beta",
      "destination": "/#notify",
      "permanent": false
    },
    {
      "source": "/:path((?!\\.well-known/assetlinks\\.json$)(?!\\.well-known/apple-app-site-association$)(?!minor-purchase/)(?!minor-promotion/).*)",
      "has": [
        {
          "type": "host",
          "value": "stumblevents.com"
        }
      ],
      "destination": "https://www.stumblevents.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/minor-purchase",
      "destination": "/minor-purchase/index.html"
    },
    {
      "source": "/minor-promotion",
      "destination": "/minor-promotion/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal/index.html"
    },
    {
      "source": "/terms",
      "destination": "/legal/index.html"
    },
    {
      "source": "/creator-agreement",
      "destination": "/legal/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/support/",
      "destination": "/support/index.html"
    },
    {
      "source": "/creator/stripe/return",
      "destination": "/api/creator/stripe/return"
    },
    {
      "source": "/creator/stripe/refresh",
      "destination": "/api/creator/stripe/refresh"
    },
    {
      "source": "/creator/stripe/development/return",
      "destination": "/api/creator/stripe/development/return"
    },
    {
      "source": "/creator/stripe/development/refresh",
      "destination": "/api/creator/stripe/development/refresh"
    },
    {
      "source": "/invite/:token",
      "destination": "/api/event?invite=:token"
    },
    {
      "source": "/event/:id",
      "destination": "/api/event?id=:id"
    },
    {
      "source": "/events/:id",
      "destination": "/api/event?id=:id"
    }
  ]
}
