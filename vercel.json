{
  "buildCommand": "node scripts/generate-well-known.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/email-verified",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!\\.well-known/assetlinks\\.json$)(?!\\.well-known/apple-app-site-association$).*)",
      "has": [
        {
          "type": "host",
          "value": "stumblevents.com"
        }
      ],
      "destination": "https://www.stumblevents.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/creator/stripe/return",
      "destination": "/api/creator/stripe/return"
    },
    {
      "source": "/creator/stripe/refresh",
      "destination": "/api/creator/stripe/refresh"
    },
    {
      "source": "/creator/stripe/development/return",
      "destination": "/api/creator/stripe/development/return"
    },
    {
      "source": "/creator/stripe/development/refresh",
      "destination": "/api/creator/stripe/development/refresh"
    },
    {
      "source": "/invite/:token",
      "destination": "/api/event?invite=:token"
    },
    {
      "source": "/events/:id",
      "destination": "/api/event?id=:id"
    }
  ]
}
